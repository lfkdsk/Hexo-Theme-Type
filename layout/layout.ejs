<!-- @format -->

<% if( page.layout==='html') { %>
<%- page.content %>
<% } if( page.layout === 'rss') { %>
<%- include('rss') %>
<% } else { %>

<!DOCTYPE html>
<%# data-skin 选中 css/tokens.scss 里的一套设计令牌。取值来自主题配置的 skin:，
    gallery 仓库可用 CONFIG.yml 的 theme_config: { skin: … } 覆盖（hexo 会 deep-merge）。 %>
<html lang="<%= config.language ? config.language : 'en' %>" data-skin="<%= theme.skin || 'modern' %>">
<!-- Head tag -->
<%- partial('_partial/head') %>
<% if(page.layout==='layout' ) { %>

<body>
  <%- page.content %>
</body>

<%} else if (page.layout==='whiteboard' ) { %>

<body>
  <!-- Nav -->
  <%- partial('_partial/nav') %>
  <!-- Main Content -->
  <%- page.content %>
  <%- partial('_partial/footer') %>
  <!-- After footer scripts -->
  <%- partial('_partial/after-footer') %>
</body>

<% } else { %>

<!--Other Pages-->
<% if (theme.schemes==='column' ) { %>

<body>
  <!-- Nav -->
  <%- partial('_partial/nav') %>
  <!-- Cover -->
  <%- partial('_partial/cover') %>
  <!-- Main Content -->
  <%- body %>
  <!-- Footer -->
  <%- partial('_partial/footer') %>
  <!-- After footer scripts -->
  <%- partial('_partial/after-footer') %>
</body>

<%} else if(theme.schemes==='m3' ) { %>

<body>
  <!-- Nav -->
  <%- partial('_partial/nav') %>
  <!-- Main Content -->
  <%- body %>
  <!-- Footer -->
  <%- partial('_partial/footer') %>
  <!-- After footer scripts -->
  <%- partial('_partial/after-footer') %>
  <%- partial('_partial/customize') %>
</body>

<% } %>
<% } %>

</html>
<% } %>